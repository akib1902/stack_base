# ---------------------------------------------------------------------------
# StackBase API configuration
# Copy to apps/api/.env and adjust. Every value is validated at startup.
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# Interface and port for the Fastify server.
HOST=127.0.0.1
PORT=8787

# Origin allowed by CORS (the Next.js web app).
WEB_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# dev      = local HS256 sessions issued by POST /api/v1/dev/session
# supabase = verify Supabase Auth access tokens
AUTH_MODE=dev

# Required when AUTH_MODE=dev. Use a long random string; never commit the real value.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
DEV_AUTH_SECRET=replace-me-with-a-long-random-secret-at-least-32-chars

# Development session lifetime in seconds (default 24h).
DEV_SESSION_TTL_SECONDS=86400

# Required when AUTH_MODE=supabase:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_JWT_SECRET=your-legacy-jwt-secret
# SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave DATABASE_URL empty to use the local PGlite database at apps/api/.data/pglite
# (no Docker, no credentials, real PostgreSQL semantics).
#
# Set it to use PostgreSQL / Supabase, e.g.:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/stackbase
DATABASE_URL=

# Only set to 1 when DATABASE_URL points at a bare PostgreSQL that has no
# Supabase auth schema and you accept the local stub being installed.
STACKBASE_LOCAL_AUTH_STUB=0

# ---------------------------------------------------------------------------
# Storage (encrypted payloads)
# ---------------------------------------------------------------------------
# local     = development/test only; ciphertext under apps/api/.data/objects/
# telegram  = ciphertext in the owner's Telegram Saved Messages
# "local" is rejected when NODE_ENV=production.
STORAGE_PROVIDER=local

# Required when STORAGE_PROVIDER=telegram (create one at https://my.telegram.org):
# TELEGRAM_API_ID=12345678
# TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Seals the stored Telegram session (AES-256-GCM). Required for telegram.
# Generate with: openssl rand -base64 32
# SESSION_ENCRYPTION_KEY=

# Upload limits (bytes / count of unfinished jobs per user).
# MAX_UPLOAD_BYTES=17179869184
# MAX_ACTIVE_UPLOADS=4

# ---------------------------------------------------------------------------
# Instrumentation
# ---------------------------------------------------------------------------
LOG_LEVEL=info
